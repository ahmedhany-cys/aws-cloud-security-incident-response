# $ aws events list-rules --name-prefix aws-sec-ir-
# 2026-10-28T06:23:15Z
{
    "Rules": [
        {
            "Name": "aws-sec-ir-iam-policy-change",
            "Arn": "arn:aws:events:us-east-1:123456789012:rule/aws-sec-ir-iam-policy-change",
            "EventPattern": "{\"detail\":{\"eventName\":[\"AttachUserPolicy\",\"AttachRolePolicy\",\"AttachGroupPolicy\",\"PutUserPolicy\",\"PutRolePolicy\",\"PutGroupPolicy\",\"CreatePolicy\",\"CreatePolicyVersion\",\"SetDefaultPolicyVersion\"],\"eventSource\":[\"iam.amazonaws.com\"]},\"detail-type\":[\"AWS API Call via CloudTrail\"],\"source\":[\"aws.iam\"]}",
            "State": "ENABLED",
            "Description": "IAM policy attached, created or inlined (privilege escalation path)",
            "EventBusName": "default"
        },
        {
            "Name": "aws-sec-ir-identity-creation",
            "Arn": "arn:aws:events:us-east-1:123456789012:rule/aws-sec-ir-identity-creation",
            "EventPattern": "{\"detail\":{\"eventName\":[\"CreateUser\",\"CreateAccessKey\",\"CreateLoginProfile\",\"UpdateLoginProfile\"],\"eventSource\":[\"iam.amazonaws.com\"]},\"detail-type\":[\"AWS API Call via CloudTrail\"],\"source\":[\"aws.iam\"]}",
            "State": "ENABLED",
            "Description": "New IAM user, access key or console password (persistence)",
            "EventBusName": "default"
        },
        {
            "Name": "aws-sec-ir-kms-key-destruction",
            "Arn": "arn:aws:events:us-east-1:123456789012:rule/aws-sec-ir-kms-key-destruction",
            "EventPattern": "{\"detail\":{\"eventName\":[\"ScheduleKeyDeletion\",\"DisableKey\"],\"eventSource\":[\"kms.amazonaws.com\"]},\"detail-type\":[\"AWS API Call via CloudTrail\"],\"source\":[\"aws.kms\"]}",
            "State": "ENABLED",
            "Description": "KMS key scheduled for deletion or disabled (impact)",
            "EventBusName": "default"
        },
        {
            "Name": "aws-sec-ir-logging-tamper",
            "Arn": "arn:aws:events:us-east-1:123456789012:rule/aws-sec-ir-logging-tamper",
            "EventPattern": "{\"detail\":{\"eventName\":[\"StopLogging\",\"DeleteTrail\",\"UpdateTrail\",\"PutEventSelectors\"],\"eventSource\":[\"cloudtrail.amazonaws.com\"]},\"detail-type\":[\"AWS API Call via CloudTrail\"],\"source\":[\"aws.cloudtrail\"]}",
            "State": "ENABLED",
            "Description": "CloudTrail logging stopped, deleted or reconfigured (defense evasion)",
            "EventBusName": "default"
        },
        {
            "Name": "aws-sec-ir-mfa-tampering",
            "Arn": "arn:aws:events:us-east-1:123456789012:rule/aws-sec-ir-mfa-tampering",
            "EventPattern": "{\"detail\":{\"eventName\":[\"DeactivateMFADevice\",\"DeleteVirtualMFADevice\"],\"eventSource\":[\"iam.amazonaws.com\"]},\"detail-type\":[\"AWS API Call via CloudTrail\"],\"source\":[\"aws.iam\"]}",
            "State": "ENABLED",
            "Description": "MFA device deactivated or deleted (defense evasion)",
            "EventBusName": "default"
        },
        {
            "Name": "aws-sec-ir-network-exposure",
            "Arn": "arn:aws:events:us-east-1:123456789012:rule/aws-sec-ir-network-exposure",
            "EventPattern": "{\"detail\":{\"eventName\":[\"AuthorizeSecurityGroupIngress\"],\"eventSource\":[\"ec2.amazonaws.com\"]},\"detail-type\":[\"AWS API Call via CloudTrail\"],\"source\":[\"aws.ec2\"]}",
            "State": "ENABLED",
            "Description": "Security group ingress rule added (possible internet exposure)",
            "EventBusName": "default"
        },
        {
            "Name": "aws-sec-ir-role-trust-change",
            "Arn": "arn:aws:events:us-east-1:123456789012:rule/aws-sec-ir-role-trust-change",
            "EventPattern": "{\"detail\":{\"eventName\":[\"UpdateAssumeRolePolicy\"],\"eventSource\":[\"iam.amazonaws.com\"]},\"detail-type\":[\"AWS API Call via CloudTrail\"],\"source\":[\"aws.iam\"]}",
            "State": "ENABLED",
            "Description": "Role trust policy changed (possible cross-account backdoor)",
            "EventBusName": "default"
        },
        {
            "Name": "aws-sec-ir-s3-permission-change",
            "Arn": "arn:aws:events:us-east-1:123456789012:rule/aws-sec-ir-s3-permission-change",
            "EventPattern": "{\"detail\":{\"eventName\":[\"PutBucketPolicy\",\"DeleteBucketPolicy\",\"PutBucketAcl\",\"PutBucketPublicAccessBlock\",\"DeleteBucketPublicAccessBlock\",\"PutAccountPublicAccessBlock\",\"DeleteAccountPublicAccessBlock\"],\"eventSource\":[\"s3.amazonaws.com\"]},\"detail-type\":[\"AWS API Call via CloudTrail\"],\"source\":[\"aws.s3\"]}",
            "State": "ENABLED",
            "Description": "S3 bucket policy, ACL or public access block changed (data exposure path)",
            "EventBusName": "default"
        }
    ]
}
