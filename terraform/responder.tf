# ---------------------------------------------------------------------------
# incident-processor Lambda: Python 3.12, 128 MB, 30 s, no VPC, no provisioned
# concurrency. Writes one JSON incident per event to the incident bucket.
# ---------------------------------------------------------------------------

data "archive_file" "incident_processor" {
  type        = "zip"
  source_file = "${path.module}/../lambda/incident_processor.py"
  output_path = "${path.module}/../lambda/incident_processor.zip"
}

# Pre-created so retention is 7 days from the first invocation and so the
# execution role never needs logs:CreateLogGroup.
resource "aws_cloudwatch_log_group" "lambda" {
  name              = local.lambda_log_group
  retention_in_days = var.lambda_log_retention_days
}

data "aws_iam_policy_document" "lambda_assume" {
  statement {
    effect  = "Allow"
    actions = ["sts:AssumeRole"]
    principals {
      type        = "Service"
      identifiers = ["lambda.amazonaws.com"]
    }
    # Only Lambda functions in this account may assume the role.
    condition {
      test     = "StringEquals"
      variable = "aws:SourceAccount"
      values   = [local.account_id]
    }
  }
}

resource "aws_iam_role" "lambda" {
  name               = "${var.name_prefix}-incident-processor-role"
  assume_role_policy = data.aws_iam_policy_document.lambda_assume.json
}

data "aws_iam_policy_document" "lambda_permissions" {
  # Write incident reports under incidents/ only. No read, list or delete.
  statement {
    sid       = "WriteIncidentReports"
    effect    = "Allow"
    actions   = ["s3:PutObject"]
    resources = ["${aws_s3_bucket.this["incidents"].arn}/incidents/*"]
  }

  # Log to its own log group only. The trailing ":*" is required because log
  # streams are sub-resources of the group and their names are generated by
  # the Lambda runtime at invocation time.
  statement {
    sid     = "WriteOwnLogs"
    effect  = "Allow"
    actions = ["logs:CreateLogStream", "logs:PutLogEvents"]
    resources = [
      "${aws_cloudwatch_log_group.lambda.arn}:*",
    ]
  }

  # Optional alert topic (only rendered when email alerts are enabled).
  dynamic "statement" {
    for_each = var.enable_email_alerts ? [1] : []
    content {
      sid       = "PublishAlerts"
      effect    = "Allow"
      actions   = ["sns:Publish"]
      resources = [aws_sns_topic.alerts[0].arn]
    }
  }
}

resource "aws_iam_role_policy" "lambda" {
  name   = "${var.name_prefix}-incident-processor-policy"
  role   = aws_iam_role.lambda.id
  policy = data.aws_iam_policy_document.lambda_permissions.json
}

resource "aws_lambda_function" "incident_processor" {
  function_name = local.lambda_function_name
  description   = "Turns suspicious CloudTrail API events into JSON incident reports in S3"
  role          = aws_iam_role.lambda.arn
  handler       = "incident_processor.handler"
  runtime       = "python3.12"
  architectures = ["arm64"] # cheaper per ms; irrelevant inside the free tier but good habit
  memory_size   = 128
  timeout       = 30

  filename         = data.archive_file.incident_processor.output_path
  source_code_hash = data.archive_file.incident_processor.output_base64sha256

  environment {
    variables = {
      INCIDENT_BUCKET = aws_s3_bucket.this["incidents"].bucket
      SNS_TOPIC_ARN   = var.enable_email_alerts ? aws_sns_topic.alerts[0].arn : ""
      LOG_LEVEL       = "INFO"
    }
  }

  depends_on = [
    aws_cloudwatch_log_group.lambda,
    aws_iam_role_policy.lambda,
  ]
}
